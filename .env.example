# Copia este archivo como .env o ejecuta: python scripts/setup_env.py
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=30
OCR_MAX_PAGES=15
OCR_RENDER_DPI=180

# Minimo 32 caracteres aleatorios. setup_env.py lo genera automaticamente.
JWT_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=agente-riesgo-financiero
JWT_AUDIENCE=agente-riesgo-financiero-api

ADMIN_USERNAME=admin
# bcrypt costo 12 solicitado por el usuario; se verifica al arrancar.
ADMIN_PASSWORD_HASH=$2a$12$yt1MX2pmqS2.YkAS17RISOvt0dwm8zkH03a/pdlXT5L0Rx..cFbF.

ANALYST_USERNAME=analista
# bcrypt costo 12 para la cuenta analista local de demostracion.
ANALYST_PASSWORD_HASH=$2a$12$voQ1vS2PpkR5Do3rPCaFJ.SmOygaLYvRP1qHKbpkMKtzr/.ugiJv6

DB_PATH=backend/db/analisis.db
MAX_UPLOAD_MB=10
MAX_CHAT_LENGTH=1000

MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=agente-riesgo-financiero
MLFLOW_UI_URL=http://localhost:5000

BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501
FRONTEND_URL=http://localhost:8501

# Gmail API (proveedor principal). Client ID/Secret tambien pueden guardarse
# desde Configuracion. El refresh token lo genera y cifra la aplicacion.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/settings/gmail/callback
GMAIL_REFRESH_TOKEN=
GMAIL_ACCOUNT_EMAIL=
GMAIL_TIMEOUT_SECONDS=20

# Correo alternativo: clave Resend con permiso `Sending access`.
# Resend usa HTTPS/443. `onboarding@resend.dev` solo puede enviar
# al correo propietario de la cuenta; para otros destinatarios verifica un dominio.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TIMEOUT_SECONDS=20

# Fallback SMTP opcional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=20

# Separar terminos adicionales con comas. Se comparan como palabras completas.
GUARDRAIL_BLOCKED_TERMS=idiota,imbecil,estupido,puta,mierda,fuck,shit
